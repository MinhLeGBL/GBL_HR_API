# DEVELOPMENT — the local containers. Copy this to `.env.development`.
#
# Development no longer needs the company network, a VPN or an SSH tunnel.
# Everything is on this machine, and `development` is the default environment,
# so the app, the tests and every script use it without being told:
#
#   python -c "from app.main import app; app.run(port=5200)"
#   python scripts/dev/devdb.py load
#
# Nothing here can reach production: every host is localhost and the ports are
# the containers', not the server's. To reach production you must ask for it by
# name — `FLASK_ENV=remote ...` — which uses `.env.remote`.

FLASK_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# ── Oracle (the gbl-dev-oracle container) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=51521
DB_SERVICE_NAME=FREEPDB1
DB_USERNAME=RPS
DB_PASSWORD=rps_dev_password
DB_ENCODING=UTF-8

# Thin mode needs no Oracle Instant Client, so a new machine runs the app with
# nothing installed but Python. Remove this (or set ORACLE_LIB_DIR) to use a
# local Instant Client instead.
ORACLE_CLIENT_MODE=thin

# Used only by load_seed.py, to confirm RPS may create tables. Must match
# ORACLE_PASSWORD in dev/docker-compose.yml. Harmless to leave blank — the
# image usually grants enough already.
ORACLE_SYSTEM_PASSWORD=oracle_dev_password

# ── PostgreSQL (the gbl-dev-postgres container) ──────────────────────────────
# No SSH tunnel: the database is on this machine.
USE_SSH_TUNNEL=false
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=gbl_master
POSTGRES_USER=gbl
POSTGRES_PASSWORD=gbl_dev_password

# ── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-not-for-production
JWT_SECRET_KEY=dev-jwt-secret-not-for-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
API_PORT=5200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Mail ─────────────────────────────────────────────────────────────────────
# dryrun, always. Local recipient rows are pseudonymised onto example.com, but
# the backstop that matters is this line: nothing is ever sent from a dev box.
MAIL_BACKEND=dryrun

# ── Development sign-in ──────────────────────────────────────────────────────
# The seed pseudonymises every email and replaces every password, so nobody can
# guess their own account. With this on, the login page offers a picker of the
# local accounts (found by real full name) and signs in with the development
# password below.
#
# It is refused outright if FLASK_ENV is production/remote, if POSTGRES_HOST is
# not local, or if an SSH tunnel is configured — and the routes are not even
# registered unless all three pass. It never mints a token without a password.
DEV_AUTH_BYPASS=true
DEV_AUTH_PASSWORD=devpassword

# ── Model ────────────────────────────────────────────────────────────────────
# Left blank on purpose. The weekly report's commentary is skipped without a
# key rather than failing, so local runs cost nothing unless you opt in.
ANTHROPIC_API_KEY=
