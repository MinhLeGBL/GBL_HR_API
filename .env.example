# =============================================================================
# GBL HR API - Environment Configuration (DEPLOYMENT)
# =============================================================================
# This configuration is for the DEPLOYMENT branch:
# - PostgreSQL: direct connection (USE_SSH_TUNNEL=false)
# - API Port: 5000
# =============================================================================

# Database Configuration (Oracle)
DB_HOST=your-oracle-host
DB_PORT=1521
DB_SERVICE_NAME=your-service-name
DB_USERNAME=your-username
DB_PASSWORD=your-password
DB_ENCODING=UTF-8

# PostgreSQL Configuration (direct connection on same server)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password

# SSH Tunnel for PostgreSQL
# Development branch: USE_SSH_TUNNEL=true (PostgreSQL on remote server)
# Deployment branch: USE_SSH_TUNNEL=false (API and PostgreSQL on same server)
USE_SSH_TUNNEL=false

# Connection Pool
DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10
DB_POOL_INCREMENT=1

# Flask Settings
SECRET_KEY=your-super-secret-key-here
DEBUG=False
FLASK_ENV=production

# API Server Settings
# Development: port 5200, Deployment: port 5000
API_PORT=5000

# API Settings
API_VERSION=v1
API_TITLE=GBL HR API
API_DESCRIPTION=HR Salary Calculation API

# CORS
CORS_ORIGINS=*

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Google Sheets Configuration
GOOGLE_SHEETS_ID=1-L91pYnXCl646Oaob3vhvh_J1sBrv-Hl0SaF8CA1Ado
GOOGLE_CREDENTIALS_FILE=config/credentials.json
