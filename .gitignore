# Deployment-specific ignores (removed from server via deploy.yml)
# tests/ - tracked in git, removed on deploy
# document/ - tracked in git, removed on deploy
docs/
!docs/deployment/
debug_endpoint.py
server.log

# Report GENERATORS are tracked (see scripts/reports/). Their OUTPUT is not --
# document/reports/ is ignored further down. The scripts were briefly ignored
# wholesale, which left them existing only in individual working trees; several
# had in fact been force-added on feature branches anyway.
# Note: deploy.yml strips document/ server-side, so tracking the scripts does
# not ship report output to production.

# Large local-only catalog/data sources kept outside git (re-fetched
# on demand, not part of the application).
document/template/
document/*.csv

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Database
*.db
*.sqlite
*.sqlite3

# Security - Never commit credentials
git_token.txt
*.pem
*.key
credentials.json
.env
.env.development
.env.production
# Local development. Its committed counterpart is .env.development.example,
# which carries the same (throwaway) container passwords. This one is ignored
# because it is the file a real ANTHROPIC_API_KEY eventually gets pasted into.
.env.local
# Production credentials, reached deliberately by FLASK_ENV=remote. The one
# file here that holds live secrets.
.env.remote

# Temporary files
temp/
tmp/
*.tmp

# Development documentation (tracked in git, removed on deploy via deploy.yml)
# document/guides, document/policies, document/pseudocode - tracked
# document/reports, document/samples, document/screenshots - local only
document/reports/
document/samples/
document/screenshots/
# The ROOT readme only. A bare `README.md` matches at every depth, which
# silently swallowed scripts/dev/README.md — the setup guide a new machine
# needs most. It had already been worked around twice with `git add -f`
# (the root one and scripts/jobs/), which is the tell.
/README.md
docs/

# Development scripts
deploy-*.sh
debug_*.py

# Development database seed bundles — extracted from production.
# Pseudonymised, but still real sales, inventory and payroll figures. These
# move between machines by hand, never through git.
dev/seed/
*.tar.gz
